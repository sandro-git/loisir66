---
// Carte d'activité (« À découvrir aussi », « À proximité », résultats de recherche).
import Icone from './Icone.astro';
import { urlForImage } from '../lib/sanity.js';
import { getFallbackImg } from '../lib/activites';
import { nomLisible, photoPrincipale } from '../lib/contenu';

interface Props { a: any; lieu?: string; class?: string; }
const { a, lieu, class: cls = '' } = Astro.props;
const nom = nomLisible(a.nom ?? '');
const photo = photoPrincipale(a);
const img = photo
  ? urlForImage(photo)?.width(720).height(480).fit('crop').auto('format').url()
  : getFallbackImg(a.nom ?? '', a.type ?? '').replace('w=480&h=200', 'w=720&h=480');
const categorie = a.soustitre || a.branche?.titre?.trim();
const ou = lieu ?? (a.ville ? nomLisible(a.ville) : a.territoire?.titre);
---
<a href={`/loisirs66/${a.slug}`} class={`group flex flex-col overflow-hidden rounded-3xl border border-trait bg-white shadow-sm transition-shadow hover:shadow-md ${cls}`}>
  <div class="relative aspect-[3/2] overflow-hidden border-b-4 border-corail bg-sable">
    <img src={img} alt="" loading="lazy" decoding="async" width="720" height="480" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
    {categorie && <span class="absolute bottom-4 left-4 max-w-[85%] truncate rounded-full bg-corail px-4 py-1.5 text-xs font-medium text-encre">{categorie}</span>}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <h3 class="text-lg font-semibold leading-snug">{nom}</h3>
    {ou && (
      <p class="mt-auto flex items-center gap-2 text-sm text-gris">
        <Icone nom="carte" class="h-4 w-4 shrink-0 text-bleu" />
        <span>{ou}</span>
        <span class="distance hidden"></span>
      </p>
    )}
  </div>
</a>
