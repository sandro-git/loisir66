---
import Site from '../../layouts/Site.astro';
import Icone from '../../components/Icone.astro';
import Carrousel from '../../components/Carrousel.astro';
import CarteActivite from '../../components/CarteActivite.astro';
import { sanityClient, urlForImage } from '../../lib/sanity.js';
import { getFallbackImg } from '../../lib/activites';
import {
  FICHE_QUERY, PROCHES_GEO_QUERY, PROCHES_TERRITOIRE_QUERY, SIMILAIRES_QUERY,
  groupesEffectifs, lignesAdresse, nomLisible, periodesOuverture, photoPrincipale, publicsAffiches, urlItineraire,
} from '../../lib/contenu';

const { slug } = Astro.params;
const a: any = sanityClient ? await sanityClient.fetch(FICHE_QUERY, { slug }).catch(() => null) : null;
if (!a) return Astro.redirect('/');

const itinerant = !!a.itinerant;
// Itinérant : la position est un point de référence interne, jamais présenté comme lieu d'accueil.
const geo = !itinerant && a.localisation?.lat != null ? a.localisation : null;
const [similaires, proches]: any[][] = sanityClient
  ? await Promise.all([
      a.brancheId ? sanityClient.fetch(SIMILAIRES_QUERY, { branche: a.brancheId, id: a._id }).catch(() => []) : [],
      // « À proximité » masqué pour un itinérant (cahier des charges §6.11).
      itinerant
        ? []
        : geo
          ? sanityClient.fetch(PROCHES_GEO_QUERY, { id: a._id, point: { _type: 'geopoint', lat: geo.lat, lng: geo.lng } }).catch(() => [])
          : a.territoireIds?.length
            ? sanityClient.fetch(PROCHES_TERRITOIRE_QUERY, { id: a._id, territoires: a.territoireIds, branche: a.brancheId ?? '' }).catch(() => [])
            : [],
    ])
  : [[], []];
// « À proximité » ne répète pas les fiches déjà proposées dans « À découvrir aussi ».
const dejaVus = new Set(similaires.map((s) => s._id));
const autour = proches.filter((p) => !dejaVus.has(p._id));

const nom = nomLisible(a.nom);
const ville = !itinerant && a.ville ? nomLisible(a.ville) : null;
const categorie = a.soustitre || a.branche?.titre?.trim();

const photos = [photoPrincipale(a), ...(a.galerie ?? [])].filter((p) => p?.asset);
const photoUrl = (p: any, w: number, h: number) => urlForImage(p)?.width(w).height(h).fit('crop').auto('format').url();
const repli = getFallbackImg(a.nom ?? '', a.type ?? '').replace('w=480&h=200', 'w=1200&h=1000');

const publics = publicsAffiches(a.publics);
const groupes = groupesEffectifs(a);
const periodes = periodesOuverture(a.periodes, a.saison);
const iconeSaison: Record<string, string> = { Printemps: 'printemps', 'Été': 'ete', Automne: 'automne', Hiver: 'hiver' };
const adresse = itinerant ? [] : lignesAdresse(a.adresse);
const itineraire = itinerant ? null : urlItineraire({ adresse: a.adresse, ville: a.ville, lat: geo?.lat, lng: geo?.lng });
const ctaTitre = a.ctaTitre || 'Envie d’y aller ?';
const ctaTexte = a.ctaTexte || 'Préparez votre visite directement auprès du professionnel.';
---

<Site title={`${nom} — Loisirs 66`} description={a.accroche || a.description?.slice(0, 155) || `${nom}, adhérent APLPO dans les Pyrénées-Orientales.`}>
  <article>
    <!-- Photo(s) -->
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <div class="relative overflow-hidden rounded-t-[2rem] border-b-[12px] border-corail bg-bleu-fonce">
        <div class="relative aspect-[4/5] sm:aspect-[16/9] lg:aspect-[21/9]" data-galerie>
          <div class="defilant h-full gap-0" data-piste>
            {photos.length ? photos.map((p, i) => (
              <picture class="relative h-full w-full">
                <source media="(min-width: 640px)" srcset={photoUrl(p, 1800, 800)} />
                <img src={photoUrl(p, 900, 1125)} alt={p.alt ?? (i === 0 ? nom : '')} width="900" height="1125" class="h-full w-full object-cover"
                  loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
              </picture>
            )) : (
              <img src={repli} alt="" width="1200" height="1000" class="h-full w-full object-cover" fetchpriority="high" />
            )}
          </div>
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/60"></div>
          <a href="/recherche" id="retour-haut" class="absolute left-6 top-6 inline-flex items-center gap-3 rounded-full bg-white px-6 py-3.5 font-medium shadow-sm hover:bg-sable sm:left-8 sm:top-8">
            <Icone nom="gauche" class="h-5 w-5" /> Retour aux résultats
          </a>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 px-8 pb-10 sm:px-12">
            {categorie && <span class="inline-block rounded-full bg-corail px-5 py-2 text-sm font-medium text-encre">{categorie}</span>}
            <h1 class="mt-5 max-w-2xl text-4xl font-bold leading-tight text-white sm:text-5xl">{nom}</h1>
          </div>
        </div>
      </div>
      {photos.length > 1 && (
        <div class="mt-6 flex justify-center gap-4" data-points>
          {photos.map((_, i) => (
            <button type="button" class={`h-2.5 rounded-full transition-all ${i === 0 ? 'w-10 bg-corail' : 'w-2.5 bg-trait'}`} aria-label={`Photo ${i + 1}`} data-index={i}></button>
          ))}
        </div>
      )}
    </div>

    <div class="mx-auto max-w-3xl px-6 sm:px-8">
      <!-- Lieu + site -->
      {(ville || itinerant || a.siteWeb) && (
        <div class="border-b border-trait py-8">
          {itinerant && (
            <p class="flex items-center gap-3 text-lg">
              <Icone nom="carte" class="h-6 w-6 text-bleu" />
              <span class="font-medium">Activité itinérante</span>
            </p>
          )}
          {ville && (
            <p class="flex items-center gap-3 text-lg">
              <Icone nom="carte" class="h-6 w-6 text-bleu" />
              <span class="font-medium">{ville}</span>
              <span id="distance" class="hidden text-gris" data-lat={geo?.lat} data-lng={geo?.lng} data-ville={a.ville}></span>
            </p>
          )}
          {a.siteWeb && (
            <a href={a.siteWeb} target="_blank" rel="noopener noreferrer" class="lien-souligne mt-5">
              Voir le site du professionnel <Icone nom="externe" class="h-5 w-5" />
            </a>
          )}
        </div>
      )}

      <!-- Présentation -->
      {(a.accroche || a.description) && (
        <section class="py-10">
          {a.surtitre && <p class="surtitre">{a.surtitre}</p>}
          {a.accroche && <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{a.accroche}</h2>}
          {a.description && <p class="mt-6 whitespace-pre-line text-lg leading-loose text-gris">{a.description}</p>}
        </section>
      )}

      {a.activites?.length > 0 && (
        <section class="border-b border-trait pb-10">
          <p class="surtitre">À vivre sur place</p>
          <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Activités proposées</h2>
          <ul class="mt-6 space-y-4 text-lg">
            {a.activites.map((x: string) => (
              <li class="flex items-start gap-3"><Icone nom="coche" class="mt-1 h-5 w-5 shrink-0 text-bleu" /> {x}</li>
            ))}
          </ul>
        </section>
      )}

      {(publics.length > 0 || groupes.length > 0) && (
        <section class="border-b border-trait py-10">
          {publics.length > 0 && (
            <>
              <p class="surtitre">Pour qui ?</p>
              <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">À partager ensemble</h2>
              <ul class="mt-6 flex flex-wrap gap-3">{publics.map((p) => <li class="pastille">{p}</li>)}</ul>
            </>
          )}
          {groupes.length > 0 && (
            <div class={publics.length ? 'mt-10' : ''}>
              <p class="surtitre">Venir à plusieurs</p>
              <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Groupes bienvenus</h2>
              <ul class="mt-6 flex flex-wrap gap-3">{groupes.map((g) => <li class="pastille">{g}</li>)}</ul>
            </div>
          )}
        </section>
      )}

      {periodes.length > 0 && (
        <section class="py-10">
          {(
            <>
              <h2 class="text-xl font-semibold">Périodes d’ouverture</h2>
              <ul class="mt-5 flex gap-6 text-bleu">
                {periodes.map((p) => (
                  <li title={p}><Icone nom={iconeSaison[p]} class="h-9 w-9" /><span class="sr-only">{p}</span></li>
                ))}
              </ul>
            </>
          )}
        </section>
      )}

      {itinerant && (
        <section class="rounded-3xl bg-sable p-8 sm:p-10">
          <p class="surtitre">Informations pratiques</p>
          <div class="mt-6 flex gap-5">
            <Icone nom="repere" class="mt-1 h-6 w-6 shrink-0 text-bleu" />
            <p class="text-lg leading-relaxed">
              <span class="font-medium">Activité itinérante</span>{a.secteur && <> – secteur d’intervention : <span class="text-gris">{a.secteur}</span></>}
            </p>
          </div>
        </section>
      )}

      {!itinerant && (adresse.length > 0 || itineraire) && (
        <section class="rounded-3xl bg-sable p-8 sm:p-10">
          <p class="surtitre">Informations pratiques</p>
          <div class="mt-6 flex gap-5">
            <Icone nom="repere" class="mt-9 h-6 w-6 shrink-0 text-bleu" />
            <div>
              <h3 class="text-lg font-medium">Le lieu de votre activité</h3>
              <address class="mt-3 text-lg not-italic leading-relaxed text-gris">
                {adresse.length ? adresse.map((l) => <>{l}<br /></>) : ville}
              </address>
            </div>
          </div>
          {itineraire && (
            <a href={itineraire} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-4 rounded-xl border border-bleu bg-white px-8 py-4 font-medium hover:bg-bleu hover:text-white">
              Préparer mon itinéraire <Icone nom="externe" class="h-5 w-5" />
            </a>
          )}
        </section>
      )}

      {a.siteWeb && (
        <section class="py-12">
          <h2 class="text-2xl font-semibold sm:text-3xl">{ctaTitre}</h2>
          <p class="mt-3 text-lg text-gris">{ctaTexte}</p>
          <a href={a.siteWeb} target="_blank" rel="noopener noreferrer" class="mt-8 flex items-center justify-center gap-3 rounded-xl bg-corail px-5 py-5 text-center font-medium sm:text-lg text-encre hover:bg-corail-fonce hover:text-white">
            Découvrir le site du professionnel <Icone nom="externe" class="h-5 w-5" />
          </a>
        </section>
      )}
    </div>
  </article>

  {similaires.length > 0 && (
    <Carrousel id="decouvrir-aussi" surtitre="Prolongez la découverte" titre="À découvrir aussi"
      intro={categorie ? `D’autres ${categorie.toLocaleLowerCase('fr')} à explorer.` : 'D’autres activités à explorer.'} fond="sable">
      {similaires.map((s) => <CarteActivite a={s} class="w-[82%] sm:w-[45%] lg:w-[31%]" />)}
    </Carrousel>
  )}

  {autour.length > 0 && (
    <Carrousel id="a-proximite" surtitre="Continuez l’exploration" titre="À proximité" intro={`Autour de ${ville ?? nom}.`}>
      {autour.map((s) => <CarteActivite a={s} class="w-[82%] sm:w-[45%] lg:w-[31%]" />)}
    </Carrousel>
  )}

  <div class="flex justify-center px-6 pb-16 pt-6">
    <a href="/recherche" id="retour-bas" class="rounded-xl border border-bleu px-10 py-5 font-medium hover:bg-bleu hover:text-white">← Retour aux résultats</a>
  </div>
</Site>

<script>
  import { haversine } from '../../lib/activites';
  import { formatDistance } from '../../lib/contenu';

  // « Retour aux résultats » renvoie vers la dernière recherche consultée.
  const derniereRecherche = () => { try { return sessionStorage.getItem('derniere-recherche'); } catch { return null; } };
  document.querySelectorAll<HTMLAnchorElement>('#retour-haut, #retour-bas').forEach((lien) => {
    const url = derniereRecherche();
    if (url) lien.href = url;
    lien.addEventListener('click', () => { const u = derniereRecherche(); if (u) lien.href = u; });
  });

  // « À découvrir aussi » : classé par distance au visiteur s'il a partagé sa position (sinon ancienneté, côté serveur).
  try {
    const pos = JSON.parse(sessionStorage.getItem('position') ?? 'null');
    const piste = document.querySelector<HTMLElement>('#decouvrir-aussi [data-piste]');
    if (pos && piste) {
      const km = (el: HTMLElement) => (el.dataset.lat ? haversine(pos.lat, pos.lng, Number(el.dataset.lat), Number(el.dataset.lng)) : Infinity);
      [...piste.children as HTMLCollectionOf<HTMLElement>]
        .map((el) => [el, km(el)] as const)
        .sort((x, y) => (x[1] === y[1] ? 0 : x[1] - y[1]))
        .forEach(([el]) => piste.appendChild(el));
    }
  } catch {}

  // Distance : seulement si le visiteur a déjà partagé sa position (bouton « autour de moi »).
  const el = document.getElementById('distance');
  try {
    const pos = JSON.parse(sessionStorage.getItem('position') ?? 'null');
    if (el && pos && el.dataset.lat) {
      el.textContent = `· ${formatDistance(haversine(pos.lat, pos.lng, Number(el.dataset.lat), Number(el.dataset.lng)))}`;
      el.classList.remove('hidden');
    }
  } catch {}

  // Points du carrousel photo.
  const piste = document.querySelector<HTMLElement>('[data-galerie] [data-piste]');
  const points = [...document.querySelectorAll<HTMLButtonElement>('[data-points] button')];
  if (piste && points.length) {
    const maj = () => {
      const i = Math.round(piste.scrollLeft / piste.clientWidth);
      points.forEach((p, j) => {
        p.classList.toggle('w-10', i === j); p.classList.toggle('bg-corail', i === j);
        p.classList.toggle('w-2.5', i !== j); p.classList.toggle('bg-trait', i !== j);
      });
    };
    piste.addEventListener('scroll', maj, { passive: true });
    points.forEach((p) => p.addEventListener('click', () => piste.scrollTo({ left: Number(p.dataset.index) * piste.clientWidth, behavior: 'smooth' })));
  }
</script>
