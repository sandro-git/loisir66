---
import Site from '../layouts/Site.astro';
import Icone from '../components/Icone.astro';
import CarteActivite from '../components/CarteActivite.astro';
import { sanityClient } from '../lib/sanity.js';
import {
  CADRES, CARTE_FIELDS, EXPERIENCES, GROUPES, ORDRE_ANCIENNETE, PUBLICS, SAISONS,
  basculerCritere, cadresEffectifs, classerParMembres, experiencesEffectives, filtrerActivites,
  groupesEffectifs, lireCriteres, periodesOuverture, sansAccents, tagsAccueil, urlRecherche,
} from '../lib/contenu';

const criteres = lireCriteres(Astro.url.searchParams);

const data: any = sanityClient
  ? await sanityClient.fetch(`{
      "activites": *[_type == "adherent"] | ${ORDRE_ANCIENNETE} { ${CARTE_FIELDS} },
      "univers": *[_type == "univers"] { titre, "slug": slug.current, "branches": branches[]->slug.current },
      "territoires": *[_type == "territoire"] { titre, "slug": slug.current }
    }`).catch(() => null)
  : null;
// Sans géolocalisation : ancienneté d'adhésion puis nom (tri fait par la requête).
const toutes: any[] = data?.activites ?? [];
const univers = classerParMembres(data?.univers ?? [], toutes, 'univers');
const territoires = classerParMembres(data?.territoires ?? [], toutes, 'territoire');

const resultats = filtrerActivites(toutes, criteres, univers);

const titre =
  univers.find((u) => u.slug === criteres.univers)?.titre ??
  territoires.find((t) => t.slug === criteres.territoire)?.titre ??
  (criteres.q ? `« ${criteres.q} »` : 'Toutes les activités');

// Options proposées : seulement les valeurs présentes chez au moins un adhérent (et celle déjà active).
const present = (valeurs: string[], extraire: (a: any) => string[], cle: string) => {
  const vus = new Set(toutes.flatMap(extraire).map(sansAccents));
  const actif = sansAccents((criteres as any)[cle] ?? '');
  return valeurs.filter((v) => vus.has(sansAccents(v)) || sansAccents(v) === actif);
};
const opts = (valeurs: string[], label = (v: string) => v) => valeurs.map((v) => ({ valeur: v.toLowerCase(), label: label(v) }));
const filtres = [
  { cle: 'univers' as const, label: 'Univers', options: univers.filter((u) => u.membres > 0).map((u) => ({ valeur: u.slug, label: u.titre })) },
  { cle: 'territoire' as const, label: 'Territoire', options: territoires.filter((t) => t.membres > 0).map((t) => ({ valeur: t.slug, label: t.titre })) },
  { cle: 'public' as const, label: 'Pour qui ?', options: opts(present(Object.keys(PUBLICS), (a) => a.publics ?? [], 'public'), (v) => PUBLICS[v]) },
  { cle: 'cadre' as const, label: 'Cadre', options: opts(present(CADRES, cadresEffectifs, 'cadre')) },
  { cle: 'experience' as const, label: 'Expérience', options: opts(present(EXPERIENCES, experiencesEffectives, 'experience')) },
  { cle: 'saison' as const, label: 'Saison', options: opts(present([...SAISONS], (a) => periodesOuverture(a.periodes, a.saison), 'saison')) },
  {
    cle: 'groupe' as const, label: 'Groupes',
    options: [{ valeur: 'tous', label: 'Tous les groupes' }, ...opts(present(GROUPES, groupesEffectifs, 'groupe'))],
  },
].filter((f) => f.options.length > 0);

const actifs = Object.keys(criteres).length > 0;

// Suggestions après la liste (cahier des charges §4) : autres univers / territoires / tags selon la provenance,
// filtre actif exclu, classées par nombre de membres décroissant.
const TAGS = new Set(['public', 'cadre', 'experience', 'groupe', 'saison']);
const provenance = criteres.univers ? 'univers' : criteres.territoire ? 'territoire' : Object.keys(criteres).some((k) => TAGS.has(k)) ? 'tag' : 'univers';
const suggestions = (
  provenance === 'territoire'
    ? territoires.filter((t) => t.slug !== criteres.territoire).map((t) => ({ label: t.titre, href: urlRecherche({ territoire: t.slug }), n: t.membres }))
    : provenance === 'tag'
      ? tagsAccueil()
          .filter((t) => Object.keys(t.params).length > 0)
          .filter((t) => !Object.entries(t.params).every(([k, v]) => sansAccents((criteres as any)[k] ?? '') === sansAccents(v)))
          .map((t) => ({ label: t.label, href: urlRecherche(t.params), n: filtrerActivites(toutes, t.params, univers).length }))
      : univers.filter((u) => u.slug !== criteres.univers).map((u) => ({ label: u.titre, href: urlRecherche({ univers: u.slug }), n: u.membres }))
)
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 8);
const titreSuggestions = { univers: 'Les autres univers', territoire: 'Les autres territoires', tag: 'D’autres envies' }[provenance];
const pluriel = resultats.length > 1 ? 's' : '';
---

<Site title={`${titre.replace(/[«»]/g, '').trim()} — Loisirs 66`} description="Trouvez une activité de loisirs dans les Pyrénées-Orientales.">
  {/* Les combinaisons de filtres restent partageables mais ne sont pas indexées (cahier des charges §11). */}
  {actifs && <meta slot="head" name="robots" content="noindex, follow" />}

  <!-- Barre de recherche fixe : réapparaît en haut quand on fait défiler les résultats -->
  <div id="barre-fixe" class="pointer-events-none fixed inset-x-0 top-0 z-40 -translate-y-full border-b border-trait bg-white/95 shadow-sm backdrop-blur transition-transform duration-200" aria-hidden="true">
    <form action="/recherche" method="get" class="mx-auto flex max-w-6xl items-center gap-2 px-6 py-2.5 sm:px-8" role="search">
      {Object.entries(criteres).filter(([k]) => k !== 'q').map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <Icone nom="loupe" class="h-5 w-5 shrink-0 text-bleu" />
      <label for="search-input-fixe" class="sr-only">Quelle activité vous tente ?</label>
      <input id="search-input-fixe" name="q" type="search" value={criteres.q ?? ''} placeholder="Quelle activité vous tente ?" autocomplete="off" tabindex="-1"
        class="min-w-0 flex-1 bg-transparent py-2 text-base text-encre placeholder:text-gris outline-none" />
      <button type="submit" tabindex="-1" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-corail text-encre" aria-label="Rechercher">
        <Icone nom="droite" class="h-5 w-5" />
      </button>
    </form>
  </div>

  <section class="mx-auto max-w-6xl px-6 pb-6 pt-4 sm:px-8">
    <p class="surtitre">Trouver une activité</p>
    <h1 class="titre-section mt-3">{titre}</h1>

    <form id="recherche-principale" action="/recherche" method="get" class="mt-8 flex items-center gap-3 rounded-2xl border border-trait bg-white p-2.5 pl-5 shadow-sm" role="search">
      {Object.entries(criteres).filter(([k]) => k !== 'q').map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <Icone nom="loupe" class="h-6 w-6 shrink-0 text-bleu" />
      <label for="search-input" class="sr-only">Quelle activité vous tente ?</label>
      <input id="search-input" name="q" type="search" value={criteres.q ?? ''} placeholder="Quelle activité vous tente ?" autocomplete="off"
        class="min-w-0 flex-1 bg-transparent py-3 text-lg text-encre placeholder:text-gris outline-none" />
      <span class="h-10 w-px bg-trait" aria-hidden="true"></span>
      <button type="button" id="btn-geolocate" class="p-2 text-bleu hover:text-bleu-fonce" title="Trier par distance" aria-label="Trier par distance" aria-pressed="false">
        <Icone nom="cible" class="h-7 w-7" />
      </button>
      <button type="submit" class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-corail text-encre hover:bg-corail-fonce hover:text-white" aria-label="Rechercher">
        <Icone nom="droite" class="h-6 w-6" />
      </button>
    </form>

    <div class="mt-8 space-y-4">
      {filtres.map((f) => (
        <div class="flex items-center gap-3">
          <span class="w-24 shrink-0 text-xs font-semibold uppercase tracking-widest text-gris">{f.label}</span>
          <ul class="defilant -mr-6 gap-2 pr-6 sm:mr-0 sm:flex-wrap sm:pr-0">
            {f.options.map((o) => {
              const actif = sansAccents(criteres[f.cle] ?? '') === sansAccents(o.valeur);
              return (
                <li>
                  <a href={basculerCritere(criteres, f.cle, o.valeur)} data-filter={f.cle} data-value={o.valeur}
                    aria-current={actif ? 'true' : undefined}
                    class={`chip block whitespace-nowrap rounded-full border px-4 py-2 text-sm transition-colors ${actif ? 'active border-corail bg-corail text-encre' : 'border-trait bg-white text-encre hover:border-bleu'}`}>
                    {o.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-8 flex items-center gap-4">
      <p id="count" class="text-gris">{resultats.length} activité{pluriel} trouvée{pluriel}</p>
      {actifs && <a id="btn-clear-filters" href="/recherche" class="text-sm font-medium text-bleu-fonce underline underline-offset-4">Effacer les filtres</a>}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20 sm:px-8" aria-label="Résultats">
    {resultats.length === 0 ? (
      <div class="rounded-3xl bg-sable p-10 text-center">
        <p class="text-lg font-medium">Aucune activité ne correspond à ces critères.</p>
        <a href="/recherche" class="lien-souligne mt-6">Voir toutes les activités</a>
      </div>
    ) : (
      <ul id="cards-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {resultats.map((a) => (
          <li class="activity-card flex" data-nom={(a.nom ?? '').toLowerCase()} data-ville={a.itinerant ? undefined : a.ville ?? undefined}
            data-lat={a.itinerant ? undefined : a.localisation?.lat} data-lng={a.itinerant ? undefined : a.localisation?.lng}>
            <CarteActivite a={a} class="w-full" />
          </li>
        ))}
      </ul>
    )}

    {suggestions.length > 0 && (
      <nav class="mt-16 rounded-3xl bg-sable p-8 sm:p-10" aria-labelledby="titre-suggestions">
        <p class="surtitre">Envie d’autre chose ?</p>
        <h2 id="titre-suggestions" class="mt-3 text-2xl font-semibold sm:text-3xl">{titreSuggestions}</h2>
        <ul class="mt-6 flex flex-wrap gap-3">
          {suggestions.map((x) => (
            <li><a href={x.href} class="pastille hover:border-bleu">{x.label} <span class="ml-2 text-gris">{x.n}</span></a></li>
          ))}
        </ul>
      </nav>
    )}
  </section>
</Site>

<script>
  import { formatDistance } from '../lib/contenu';
  import { haversine } from '../lib/activites';

  const grid = document.getElementById('cards-grid');
  const cards = [...document.querySelectorAll<HTMLElement>('.activity-card')];
  const btnGeo = document.getElementById('btn-geolocate') as HTMLButtonElement;

  // Mémorise l'origine de la recherche pour le bouton « Retour aux résultats » des fiches.
  try { sessionStorage.setItem('derniere-recherche', location.pathname + location.search); } catch {}

  const cache: Record<string, { lat: number; lng: number } | null> = {};
  async function geocoder(ville: string) {
    if (ville in cache) return cache[ville];
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(ville + ', Pyrénées-Orientales, France')}&format=json&limit=1`, { headers: { 'Accept-Language': 'fr' } });
      const d = await res.json();
      cache[ville] = d[0] ? { lat: parseFloat(d[0].lat), lng: parseFloat(d[0].lon) } : null;
      await new Promise((r) => setTimeout(r, 1100)); // politique d'usage de Nominatim : 1 requête / s
    } catch { cache[ville] = null; }
    return cache[ville];
  }

  async function trierParDistance(pos: { lat: number; lng: number }) {
    btnGeo.disabled = true;
    for (const card of cards) {
      let coords = card.dataset.lat ? { lat: Number(card.dataset.lat), lng: Number(card.dataset.lng) } : null;
      if (!coords && card.dataset.ville) coords = await geocoder(card.dataset.ville);
      const km = coords ? haversine(pos.lat, pos.lng, coords.lat, coords.lng) : Infinity;
      card.dataset.distanceKm = String(km);
      const badge = card.querySelector<HTMLElement>('.distance');
      if (badge && Number.isFinite(km)) { badge.textContent = `· ${formatDistance(km)}`; badge.classList.remove('hidden'); }
    }
    // Tri stable : à distance égale (ou inconnue), l'ordre d'ancienneté est conservé.
    const km = (c: HTMLElement) => Number(c.dataset.distanceKm);
    cards.sort((a, b) => (km(a) === km(b) ? 0 : km(a) - km(b))).forEach((c) => grid?.appendChild(c));
    btnGeo.disabled = false;
    btnGeo.setAttribute('aria-pressed', 'true');
    btnGeo.classList.add('text-corail');
    btnGeo.title = 'Ne plus trier par distance'; btnGeo.setAttribute('aria-label', 'Ne plus trier par distance');
  }

  // Le tri par distance choisi est conservé pendant la navigation (retour d'une fiche, autre filtre…).
  const triActif = () => { try { return sessionStorage.getItem('tri-distance') === '1'; } catch { return false; } };
  const memoriserTri = (oui: boolean) => { try { oui ? sessionStorage.setItem('tri-distance', '1') : sessionStorage.removeItem('tri-distance'); } catch {} };

  function positionMemorisee(): { lat: number; lng: number } | null {
    try { return JSON.parse(sessionStorage.getItem('position') ?? 'null'); } catch { return null; }
  }

  btnGeo?.addEventListener('click', () => {
    if (btnGeo.getAttribute('aria-pressed') === 'true') { memoriserTri(false); location.reload(); return; }
    if (!navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(
      (p) => {
        const pos = { lat: p.coords.latitude, lng: p.coords.longitude };
        try { sessionStorage.setItem('position', JSON.stringify(pos)); } catch {}
        memoriserTri(true);
        trierParDistance(pos);
      },
      (err) => { if (err.code !== err.PERMISSION_DENIED) alert("Impossible d'obtenir votre position."); },
      { timeout: 10000 }
    );
  });

  if (new URLSearchParams(location.search).has('autour') || triActif()) {
    const pos = positionMemorisee();
    if (pos) { memoriserTri(true); trierParDistance(pos); }
  }

  // Barre fixe : visible dès que le formulaire principal sort de l'écran.
  const barre = document.getElementById('barre-fixe')!;
  const principal = document.getElementById('recherche-principale');
  const champFixe = document.getElementById('search-input-fixe') as HTMLInputElement;
  if (principal) {
    new IntersectionObserver(([e]) => {
      const visible = !e.isIntersecting;
      barre.classList.toggle('-translate-y-full', !visible);
      barre.classList.toggle('pointer-events-none', !visible);
      barre.setAttribute('aria-hidden', String(!visible));
      barre.querySelectorAll<HTMLElement>('input, button').forEach((el) => (el.tabIndex = visible ? 0 : -1));
    }).observe(principal);
  }
  document.getElementById('search-input')?.addEventListener('input', (e) => { champFixe.value = (e.target as HTMLInputElement).value; });
</script>
