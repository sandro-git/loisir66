---
import Site from '../layouts/Site.astro';
import Icone from '../components/Icone.astro';
import Carrousel from '../components/Carrousel.astro';
import { sanityClient, urlForImage } from '../lib/sanity.js';
import { ACCUEIL_QUERY, classerParMembres, tagsAccueil, urlRecherche } from '../lib/contenu';
import { jsonLdAccueil } from '../lib/seo';

const data: any = sanityClient ? await sanityClient.fetch(ACCUEIL_QUERY).catch(() => null) : null;
const accueil = data?.accueil ?? {};
// Ordre automatique : nombre de membres décroissant (cahier des charges §2).
const membres: any[] = data?.membres ?? [];
const univers = classerParMembres(data?.univers ?? [], membres, 'univers');
const territoires = classerParMembres(data?.territoires ?? [], membres, 'territoire');

const img = (source: any, w: number, h: number) =>
  source?.asset ? urlForImage(source)?.width(w).height(h).fit('crop').auto('format').url() : null;

const slides = (accueil.slides ?? []).filter((s: any) => s?.asset);
const instagramPhotos = (accueil.instagramPhotos ?? []).filter((s: any) => s?.asset);
const donneesStructurees = jsonLdAccueil(Astro.url.origin, {
  email: accueil.email || 'contact.aplpo@gmail.com',
  telephone: accueil.telephone,
  reseaux: [accueil.instagram, accueil.facebook, accueil.linkedin].filter(Boolean),
});
const heroTitre = accueil.heroTitre || 'Découvrez les loisirs du 66,';
const heroSousTitre = accueil.heroSousTitre || 'directement auprès des professionnels d’ici.';
---

<Site image={slides[0] ? img(slides[0], 1200, 630) : null} jsonLd={donneesStructurees} title="Loisirs 66 — Découvrez les loisirs des Pyrénées-Orientales" description="Activités et loisirs dans les Pyrénées-Orientales, directement auprès des professionnels adhérents de l’APLPO.">
  <!-- Bandeau principal -->
  <section class="mx-auto max-w-6xl px-6 sm:px-8" aria-label="À la une">
    <div class="relative overflow-hidden rounded-t-[2rem] border-b-[12px] border-corail bg-bleu-fonce" data-hero>
      <div class="relative aspect-[4/5] sm:aspect-[16/10] lg:aspect-[21/9]">
        {slides.map((s: any, i: number) => (
          <picture>
            <source media="(min-width: 640px)" srcset={img(s, 1800, 900)} />
            <img src={img(s, 900, 1100)} alt={s.alt ?? ''} width="900" height="1100"
              class={`hero-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
              loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          </picture>
        ))}
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/10 to-black/60"></div>
        <div class="absolute inset-x-0 bottom-0 px-8 pb-20 sm:px-12 sm:pb-24">
          <h1 class="max-w-xl text-5xl font-semibold leading-[1.05] tracking-tight text-white sm:text-6xl">{heroTitre}</h1>
          <p class="mt-5 max-w-md text-xl leading-relaxed text-white sm:text-2xl">{heroSousTitre}</p>
        </div>
        {slides.length > 1 && (
          <div class="absolute inset-x-0 bottom-7 flex justify-center gap-4" role="tablist" aria-label="Choisir une photo">
            {slides.map((_: any, i: number) => (
              <button type="button" class={`hero-point h-2.5 rounded-full transition-all ${i === 0 ? 'w-10 bg-corail' : 'w-2.5 bg-white/70'}`}
                aria-label={`Photo ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} role="tab" data-index={i}></button>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Recherche -->
    <form action="/recherche" method="get" class="relative z-10 mx-auto mt-8 flex max-w-3xl items-center gap-1.5 rounded-2xl border border-trait bg-white p-2 pl-3.5 shadow-sm sm:gap-3 sm:p-2.5 sm:pl-5" role="search">
      <Icone nom="loupe" class="h-5 w-5 shrink-0 text-bleu sm:h-6 sm:w-6" />
      <label for="recherche-accueil" class="sr-only">Quelle activité vous tente ?</label>
      <input id="recherche-accueil" name="q" type="search" placeholder="Quelle activité vous tente ?" autocomplete="off"
        class="min-w-0 flex-1 bg-transparent py-3 text-sm text-encre placeholder:text-gris outline-none sm:text-lg" />
      <span class="h-9 w-px bg-trait" aria-hidden="true"></span>
      <button type="button" id="btn-autour" class="p-1.5 text-bleu hover:text-bleu-fonce sm:p-2" title="Activités autour de moi" aria-label="Activités autour de moi">
        <Icone nom="cible" class="h-6 w-6 sm:h-7 sm:w-7" />
      </button>
      <button type="submit" class="flex h-12 w-12 shrink-0 sm:h-14 sm:w-14 items-center justify-center rounded-xl bg-corail text-encre hover:bg-corail-fonce hover:text-white" aria-label="Rechercher">
        <Icone nom="droite" class="h-6 w-6" />
      </button>
    </form>
  </section>

  <!-- Raccourcis -->
  <nav class="mx-auto mt-8 max-w-6xl sm:px-8" aria-label="Raccourcis">
    <ul class="defilant scroll-px-6 bg-corail px-6 py-5 sm:rounded-2xl sm:px-8 lg:justify-center">
      {tagsAccueil().map((r) => (
        <li><a href={urlRecherche(r.params)} class="block whitespace-nowrap rounded-full border border-encre/30 px-5 py-3 text-[15px] font-medium text-encre transition-colors hover:bg-white/30">{r.label}</a></li>
      ))}
    </ul>
  </nav>

  <!-- Nos univers -->
  {univers.length > 0 && (
    <section id="univers" class="mx-auto max-w-6xl scroll-mt-6 px-6 py-16 sm:px-8">
      <p class="surtitre">À chacun ses envies</p>
      <h2 class="titre-section mt-3">Nos univers</h2>
      <p class="mt-4 max-w-sm text-lg leading-relaxed text-gris">Des idées pour s’évader, partager et profiter du 66.</p>
      <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-3 xl:grid-cols-6 xl:gap-4">
        {univers.map((u) => (
          <li>
            <a href={urlRecherche({ univers: u.slug })} class="group flex h-full flex-col overflow-hidden rounded-3xl border border-trait bg-white shadow-sm transition-shadow hover:shadow-md">
              <div class="aspect-[6/5] overflow-hidden border-b-4 border-corail bg-sable">
                {img(u.image, 640, 540) && <img src={img(u.image, 640, 540)} alt="" loading="lazy" decoding="async" width="640" height="540" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />}
              </div>
              <div class="flex flex-1 items-start justify-between gap-2 p-4 pb-8 sm:gap-3 sm:p-6 sm:pb-10 xl:p-4 xl:pb-6">
                <h3 class="min-w-0 text-[15px] font-semibold leading-snug [hyphens:none] sm:text-xl xl:text-base">{u.titre}</h3>
                <Icone nom="externe" class="mt-0.5 h-5 w-5 shrink-0 text-bleu" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Nos territoires -->
  {territoires.length > 0 && (
    <section id="territoires" class="scroll-mt-6 sm:px-8">
      <div class="mx-auto max-w-6xl bg-sable px-6 py-16 sm:rounded-3xl sm:px-8">
        <p class="surtitre">Des Pyrénées à la Méditerranée</p>
        <h2 class="titre-section mt-3">Nos territoires</h2>
        <p class="mt-4 text-lg text-gris">Quatre façons de changer d’air.</p>
        <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
          {territoires.map((t) => (
            <li>
              <a href={urlRecherche({ territoire: t.slug })} class="group relative block aspect-[7/8] overflow-hidden rounded-3xl bg-bleu-fonce shadow-sm">
                {img(t.image, 600, 690) && <img src={img(t.image, 600, 690)} alt="" loading="lazy" decoding="async" width="600" height="690" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />}
                <div class="absolute inset-0 bg-gradient-to-b from-transparent from-40% to-black/70"></div>
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 p-4 sm:p-6">
                  <h3 class="min-w-0 text-lg font-bold leading-tight text-white sm:text-2xl">{t.titre}</h3>
                  <Icone nom="externe" class="h-5 w-5 shrink-0 text-white sm:h-6 sm:w-6" />
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Instagram -->
  {instagramPhotos.length > 0 && (
    <Carrousel id="instagram" surtitre="Les loisirs se partagent" titre="Vos loisirs sur Instagram">
      {instagramPhotos.map((p: any) => {
        const contenu = <img src={img(p, 640, 620)} alt={p.alt ?? ''} loading="lazy" decoding="async" width="640" height="620" class="h-full w-full object-cover" />;
        return (
          <div class="aspect-[32/31] w-[78%] overflow-hidden rounded-3xl sm:w-[45%] lg:w-[31%]">
            {p.lien || accueil.instagram ? <a href={p.lien || accueil.instagram} target="_blank" rel="noopener noreferrer" class="block h-full">{contenu}</a> : contenu}
          </div>
        );
      })}
      {accueil.instagram && (
        <a slot="apres" href={accueil.instagram} target="_blank" rel="noopener noreferrer" class="lien-souligne mt-10 text-lg">
          <Icone nom="instagram" class="h-7 w-7 text-encre" />
          Retrouvez-nous sur Instagram
          <Icone nom="externe" class="h-5 w-5" />
        </a>
      )}
    </Carrousel>
  )}
</Site>

<script>
  // Carrousel du bandeau : défilement automatique (sauf si l'utilisateur préfère moins d'animations) + points.
  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  const points = [...document.querySelectorAll<HTMLButtonElement>('.hero-point')];
  let courant = 0;
  let minuteur: number | undefined;
  function montrer(i: number) {
    courant = (i + slides.length) % slides.length;
    slides.forEach((s, j) => { s.classList.toggle('opacity-100', j === courant); s.classList.toggle('opacity-0', j !== courant); });
    points.forEach((p, j) => {
      const actif = j === courant;
      p.classList.toggle('w-10', actif); p.classList.toggle('bg-corail', actif);
      p.classList.toggle('w-2.5', !actif); p.classList.toggle('bg-white/70', !actif);
      p.setAttribute('aria-selected', String(actif));
    });
  }
  function demarrer() {
    if (slides.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    clearInterval(minuteur);
    minuteur = window.setInterval(() => montrer(courant + 1), 6000);
  }
  points.forEach((p) => p.addEventListener('click', () => { montrer(Number(p.dataset.index)); demarrer(); }));
  demarrer();

  // « Autour de moi » : on mémorise la position puis on ouvre la recherche triée par distance.
  document.getElementById('btn-autour')?.addEventListener('click', () => {
    if (!navigator.geolocation) { location.href = '/recherche'; return; }
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        try { sessionStorage.setItem('position', JSON.stringify({ lat: latitude, lng: longitude })); sessionStorage.setItem('tri-distance', '1'); } catch {}
        location.href = '/recherche?autour=1';
      },
      () => { location.href = '/recherche'; },
      { timeout: 10000 }
    );
  });
</script>
