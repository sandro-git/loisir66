---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';
import { sanityClient, urlForImage } from '../lib/sanity.js';
import { createClient as createSanityClient } from '@sanity/client';
import { MES_CAMPAGNES_QUERY } from '../lib/promo';
import { CADRES, EXPERIENCES, GROUPES, PUBLICS, SAISONS } from '../lib/contenu';
import { LIMITES } from '../lib/profil';

// Auth
const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/connexion');

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  { global: { headers: { Authorization: `Bearer ${accessToken}` } } }
);

const { data: { user }, error: authError } = await supabase.auth.getUser();
if (authError || !user) return Astro.redirect('/connexion');

// Récupère la fiche liée
const { data: adherentRow } = await supabase
  .from('adherents')
  .select('sanity_doc_id')
  .eq('id', user.id)
  .single();

let fiche: any = null;
if (adherentRow?.sanity_doc_id && sanityClient) {
  fiche = await sanityClient.fetch(
    `*[_type == "adherent" && _id == $id][0]{
      _id, nom, accroche, description, activites, publics, groupes, experiences, cadres, periodes,
      ville, adresse, siteWeb, image
    }`,
    { id: adherentRow.sanity_doc_id.trim() }
  ).catch(() => null);
}

// « Mes campagnes » (lecture seule) : campagnes privées où figure CETTE structure, réduites à ses offres.
let campagnes: any[] = [];
const docId = adherentRow?.sanity_doc_id?.trim();
if (docId && import.meta.env.SANITY_READ_TOKEN) {
  const lecteur = createSanityClient({
    projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
    dataset: import.meta.env.PUBLIC_SANITY_DATASET ?? 'production',
    apiVersion: import.meta.env.PUBLIC_SANITY_API_VERSION ?? '2024-01-01',
    useCdn: false,
    token: import.meta.env.SANITY_READ_TOKEN,
    perspective: 'published',
  });
  campagnes = await lecteur.fetch(MES_CAMPAGNES_QUERY, { id: docId }).catch(() => []);
}
const dateFr = (iso?: string) => (iso ? iso.split('-').reverse().join('/') : '');

const success = Astro.url.searchParams.get('success');
const erreur  = Astro.url.searchParams.get('erreur');

const cases = [
  { nom: 'publics', titre: 'Pour qui ?', options: Object.entries(PUBLICS).map(([valeur, label]) => ({ valeur, label })) },
  { nom: 'groupes', titre: 'Groupes accueillis', options: GROUPES.map((v) => ({ valeur: v, label: v })) },
  { nom: 'experiences', titre: 'Expérience', options: EXPERIENCES.map((v) => ({ valeur: v, label: v })) },
  { nom: 'cadres', titre: 'Cadre', options: CADRES.map((v) => ({ valeur: v, label: v })) },
  { nom: 'periodes', titre: 'Saisons d’ouverture', options: SAISONS.map((v) => ({ valeur: v, label: v })) },
];
const activites: string[] = [...(fiche?.activites ?? []), '', '', '', ''].slice(0, LIMITES.activites);
const champ = 'w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 outline-none focus:border-orange-400';
---

<Layout noindex title="Mon profil — Loisirs 66">
  <main class="max-w-2xl mx-auto px-4 py-8">

    <!-- Logo -->
    <div class="flex justify-center mb-8">
      <img src="/logo-aplpo.avif" alt="APLPO" class="h-16 w-auto" />
    </div>

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Ma fiche activité</h1>
        <p class="text-gray-500 text-sm">{user.email}</p>
      </div>
      <form method="POST" action="/api/logout">
        <button class="text-gray-500 text-sm hover:text-orange-500 transition-colors">
          Déconnexion
        </button>
      </form>
    </div>

    {success === '1' && (
      <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-6">
        Fiche mise à jour avec succès.
      </div>
    )}

    {erreur && erreur !== 'no-doc' && (
      <div class="bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3 mb-6" role="alert">{erreur}</div>
    )}

    {erreur === 'no-doc' && (
      <div class="bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3 mb-6">
        Aucune fiche n'est encore liée à votre compte. Contactez l'administrateur.
      </div>
    )}

    {campagnes.length > 0 && (
      <section class="bg-white border border-gray-100 shadow-sm rounded-2xl p-6 mb-6" aria-labelledby="titre-campagnes">
        <h2 id="titre-campagnes" class="text-lg font-bold text-gray-900">Mes campagnes</h2>
        <p class="text-gray-500 text-sm mt-1">Campagnes promo de l’APLPO auxquelles vous participez (lecture seule). Pour toute modification, contactez l’APLPO.</p>
        <ul class="mt-4 space-y-4">
          {campagnes.map((c) => (
            <li class="border border-gray-100 rounded-xl p-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-semibold text-gray-900">{c.nom}</span>
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${c.etat === 'active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}`}>{c.etat === 'active' ? 'Active' : 'Terminée'}</span>
              </div>
              {(c.debut || c.fin) && <p class="text-sm text-gray-500 mt-1">{c.debut && `Du ${dateFr(c.debut)}`} {c.fin && `au ${dateFr(c.fin)}`}</p>}
              {c.codes?.length > 0 && <p class="text-sm mt-2"><span class="text-gray-500">Codes utilisables :</span> <span class="font-mono">{c.codes.join(', ')}</span></p>}
              {(c.offres ?? []).map((o: any) => (
                <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
                  {o.tarifPromo && <><dt class="text-gray-500">Tarif promo</dt><dd class="font-medium">{o.tarifPromo}</dd></>}
                  {o.tarifPublic && <><dt class="text-gray-500">Tarif public</dt><dd>{o.tarifPublic}</dd></>}
                  {(o.debut || o.fin) && <><dt class="text-gray-500">Validité</dt><dd>{o.debut && `du ${dateFr(o.debut)}`} {o.fin && `au ${dateFr(o.fin)}`}</dd></>}
                  {o.conditions && <><dt class="text-gray-500">Conditions</dt><dd class="whitespace-pre-line">{o.conditions}</dd></>}
                </dl>
              ))}
            </li>
          ))}
        </ul>
      </section>
    )}

    {!adherentRow?.sanity_doc_id ? (
      <div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-8 text-center">
        <p class="text-gray-600">Votre compte n'est pas encore lié à une fiche activité.</p>
        <p class="text-gray-500 text-sm mt-2">Contactez l'administrateur APLPO.</p>
      </div>
    ) : (
      <form method="POST" action="/api/update-profil" enctype="multipart/form-data" class="space-y-6">
        <div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-6 space-y-5">
          <h2 class="text-xs text-gray-400 uppercase tracking-widest">Présentation</h2>
          <div>
            <label for="f-nom" class="block text-sm text-gray-600 mb-2">Nom de la structure *</label>
            <input id="f-nom" name="nom" type="text" required value={fiche?.nom ?? ''} class={champ} />
          </div>
          <div>
            <label for="f-accroche" class="block text-sm text-gray-600 mb-2">Accroche <span class="text-gray-400">({LIMITES.accroche} caractères max.)</span></label>
            <input id="f-accroche" name="accroche" type="text" maxlength={LIMITES.accroche} value={fiche?.accroche ?? ''}
              placeholder="Ex : Kite & Foil - La liberté à l’état pur" class={champ} />
          </div>
          <div>
            <label for="f-description" class="block text-sm text-gray-600 mb-2">Présentation courte <span class="text-gray-400">({LIMITES.description} caractères max.)</span></label>
            <textarea id="f-description" name="description" rows={6} maxlength={LIMITES.description} class={`${champ} resize-y`}>{fiche?.description ?? ''}</textarea>
          </div>
          <fieldset>
            <legend class="block text-sm text-gray-600 mb-2">Activités proposées <span class="text-gray-400">({LIMITES.activites} max.)</span></legend>
            <div class="space-y-2">
              {activites.map((x, i) => (
                <input name="activites" type="text" value={x} aria-label={`Activité ${i + 1}`} placeholder={i === 0 ? 'Ex : Paddle' : ''} class={champ} />
              ))}
            </div>
          </fieldset>
        </div>

        <div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-6 space-y-6">
          <h2 class="text-xs text-gray-400 uppercase tracking-widest">Tags</h2>
          {cases.map((c) => (
            <fieldset>
              <legend class="block text-sm text-gray-600 mb-3">{c.titre}</legend>
              <div class="flex flex-wrap gap-x-5 gap-y-3">
                {c.options.map((o) => (
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name={c.nom} value={o.valeur} checked={(fiche?.[c.nom] ?? []).includes(o.valeur)} class="accent-orange-500" />
                    <span class="text-sm text-gray-700">{o.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>

        <div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-6 space-y-5">
          <h2 class="text-xs text-gray-400 uppercase tracking-widest">Lieu de l’activité</h2>
          <div>
            <label for="f-ville" class="block text-sm text-gray-600 mb-2">Ville</label>
            <input id="f-ville" name="ville" type="text" value={fiche?.ville ?? ''} class={champ} />
          </div>
          <div>
            <label for="f-adresse" class="block text-sm text-gray-600 mb-2">Adresse du lieu d’accueil (pas le siège social)</label>
            <textarea id="f-adresse" name="adresse" rows={2} placeholder="Ex : Rue du Cady&#10;66820 Casteil" class={`${champ} resize-none`}>{fiche?.adresse ?? ''}</textarea>
          </div>
          <div>
            <label for="f-site" class="block text-sm text-gray-600 mb-2">Site web</label>
            <input id="f-site" name="siteWeb" type="url" value={fiche?.siteWeb ?? ''} placeholder="https://..." class={champ} />
          </div>
          <p class="text-xs text-gray-400">Branche, univers, territoires et activité itinérante sont gérés par l’APLPO.</p>
        </div>

        <!-- Image -->
        <div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-6 space-y-4">
          <h2 class="text-xs text-gray-400 uppercase tracking-widest">Photo principale</h2>

          {fiche?.image && (
            <img
              src={urlForImage(fiche.image)?.width(300).height(150).fit('crop').url() ?? ''}
              alt="Image actuelle"
              class="w-full h-36 object-cover rounded-xl"
            />
          )}

          <div>
            <label class="block text-sm text-gray-600 mb-2">
              {fiche?.image ? 'Remplacer la photo' : 'Ajouter une photo (immersive, pas le logo)'}
            </label>
            <label class="flex items-center gap-3 cursor-pointer w-full bg-white border border-gray-200 rounded-lg px-4 py-3 hover:border-orange-400 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span id="file-label" class="text-sm text-gray-500 truncate">Choisir une image…</span>
              <input
                type="file"
                name="image"
                accept="image/*"
                class="sr-only"
                id="image-input"
              />
            </label>
          </div>
        </div>

        <button
          type="submit"
          class="w-full bg-orange-500 hover:bg-orange-600 text-white font-medium py-3 rounded-xl transition-colors"
        >
          Enregistrer les modifications
        </button>

        <a href="/" class="block text-center text-gray-500 text-sm hover:text-orange-500 transition-colors">
          ← Retour aux activités
        </a>
      </form>
    )}
  </main>
<script>
  document.getElementById('image-input')?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const label = document.getElementById('file-label');
    if (label) {
      label.textContent = input.files?.[0]?.name ?? 'Choisir une image…';
    }
  });
</script>
</Layout>
